{
  "name": "curb-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "curb.markets: the Curb website (Vite MPA, vanilla TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
